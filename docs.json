{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lynx",
  "colors": {
    "primary": "#334CFF",
    "light": "#537EFC",
    "dark": "#313494"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "navbar": {
          "links": [
            {
              "label": "Support",
              "href": "mailto:partners@hvnn.me"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Dashboard",
            "href": "https://app.lynxops.co"
          }
        },
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "sdk/quickstart", "openapi/overview"]
          },
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/configuration",
              "sdk/tracing",
              "sdk/instrumentation",
              "sdk/guardrails",
              "sdk/delivery",
              "sdk/api-reference"
            ]
          },
          {
            "group": "OpenAPI",
            "pages": [
              "openapi/events",
              "openapi/runtime-config",
              "openapi/issue-records",
              "openapi/runs"
            ]
          }
        ]
      },
      {
        "language": "ko",
        "navbar": {
          "links": [
            {
              "label": "지원",
              "href": "mailto:partners@hvnn.me"
            }
          ],
          "primary": {
            "type": "button",
            "label": "대시보드",
            "href": "https://app.lynxops.co"
          }
        },
        "groups": [
          {
            "group": "시작하기",
            "pages": [
              "ko/index",
              "ko/sdk/quickstart",
              "ko/openapi/overview"
            ]
          },
          {
            "group": "TypeScript SDK",
            "pages": [
              "ko/sdk/configuration",
              "ko/sdk/tracing",
              "ko/sdk/instrumentation",
              "ko/sdk/guardrails",
              "ko/sdk/delivery",
              "ko/sdk/api-reference"
            ]
          },
          {
            "group": "OpenAPI",
            "pages": [
              "ko/openapi/events",
              "ko/openapi/runtime-config",
              "ko/openapi/issue-records",
              "ko/openapi/runs"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "fonts": {
    "family": "InterDisplay",
    "source": "/fonts/PretendardVariable.woff2",
    "format": "woff2",
    "weight": 400
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hvnn-oss"
    }
  }
}
